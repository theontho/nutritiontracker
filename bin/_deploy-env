#!/usr/bin/env bash
# Load deployment settings and expose $SSH / $SCP_TARGET helpers.
#
# Sourced by the bin/ scripts; not meant to be run directly.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${NUTRITION_TRACKER_DEPLOY_ENV:-$REPO_ROOT/deploy/deploy.env}"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "Missing $ENV_FILE" >&2
  echo "Create it with: cp deploy/deploy.env.example deploy/deploy.env" >&2
  exit 1
fi

# shellcheck disable=SC1090
set -a; source "$ENV_FILE"; set +a

# Only the connection details are needed by every caller. Scripts that drive a
# systemd host ask for the rest themselves, so a container host can share this
# file without inventing values it will never use.
require_vars() {
  for required in "$@"; do
    if [[ -z "${!required:-}" ]]; then
      echo "$required is not set in $ENV_FILE" >&2
      exit 1
    fi
  done
}

require_vars NUTRITION_TRACKER_DEPLOY_HOST NUTRITION_TRACKER_DEPLOY_USER

SSH_OPTS=()
if [[ -n "${NUTRITION_TRACKER_DEPLOY_SSH_KEY:-}" ]]; then
  SSH_OPTS+=(-i "${NUTRITION_TRACKER_DEPLOY_SSH_KEY/#\~/$HOME}")
fi

TARGET="$NUTRITION_TRACKER_DEPLOY_USER@$NUTRITION_TRACKER_DEPLOY_HOST"
SSH=(ssh "${SSH_OPTS[@]}" "$TARGET")
RSYNC_SSH="ssh ${SSH_OPTS[*]}"

remote() { "${SSH[@]}" "$@"; }
