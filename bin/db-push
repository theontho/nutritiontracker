#!/usr/bin/env bash
# Replace the live database with a locally built one, preserving personal data.
#
# Usage:
#   bin/db-push <local-db>
#
# A rebuilt food catalog contains no diary, weight or recipe records, so the
# live personal data is merged into the incoming file before anything is
# swapped. The service is stopped only for the swap itself.

source "$(dirname "${BASH_SOURCE[0]}")/_deploy-env"

if [[ $# -ne 1 ]]; then
  echo "Usage: bin/db-push <local-db>" >&2
  exit 1
fi

LOCAL_DB="$1"
[[ -f "$LOCAL_DB" ]] || { echo "No such file: $LOCAL_DB" >&2; exit 1; }

STAMP=$(date +%Y%m%d-%H%M%S)
BACKUP_DIR="${NT_DEPLOY_BACKUP_DIR:-/tmp}"
REMOTE_BACKUP="$BACKUP_DIR/nutrition-preswap-$STAMP.db"
REMOTE_INCOMING="$BACKUP_DIR/nutrition-incoming-$STAMP.db"

echo "==> Backing up the live database"
remote "mkdir -p '$BACKUP_DIR' && cd '$NT_DEPLOY_DIR' && .venv/bin/python - <<'PY'
import sqlite3
src = sqlite3.connect("file:$NT_DEPLOY_DB?mode=ro", uri=True)
dst = sqlite3.connect("$REMOTE_BACKUP")
src.backup(dst); dst.close(); src.close()
print("backup written")
PY"

echo "==> Uploading $(du -h "$LOCAL_DB" | cut -f1) to $NT_DEPLOY_HOST"
rsync -az --info=progress2 -e "$RSYNC_SSH" "$LOCAL_DB" "$TARGET:$REMOTE_INCOMING"

echo "==> Merging live personal data into the incoming database"
remote "set -euo pipefail
cd '$NT_DEPLOY_DIR'
.venv/bin/python -m scripts.migrate_personal_data '$REMOTE_BACKUP' '$REMOTE_INCOMING'"

echo "==> Swapping the database in"
remote "set -euo pipefail
sudo systemctl stop '$NT_DEPLOY_SERVICE'
mv '$NT_DEPLOY_DB' '$NT_DEPLOY_DB.replaced-$STAMP'
rm -f '$NT_DEPLOY_DB-wal' '$NT_DEPLOY_DB-shm'
mv '$REMOTE_INCOMING' '$NT_DEPLOY_DB'
chmod 600 '$NT_DEPLOY_DB'
sudo systemctl start '$NT_DEPLOY_SERVICE'
sleep 3
systemctl is-active '$NT_DEPLOY_SERVICE'"

echo "==> Health"
remote "curl -fsS http://127.0.0.1:8000/health" && echo
echo "Previous database kept at $NT_DEPLOY_DB.replaced-$STAMP and $REMOTE_BACKUP"
