#!/usr/bin/env bash
# Deploy the application code to the host and restart the service.
#
# Usage:
#   bin/deploy [--ref <git-ref>]
#
# The host runs a plain git checkout under systemd, so deploying is a fetch,
# a dependency sync, an Alembic upgrade and a unit restart.

source "$(dirname "${BASH_SOURCE[0]}")/_deploy-env"

require_vars NUTRITION_TRACKER_DEPLOY_DIR NUTRITION_TRACKER_DEPLOY_SERVICE NUTRITION_TRACKER_DEPLOY_DB

REF="${NUTRITION_TRACKER_DEPLOY_BRANCH:-main}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --ref) REF="$2"; shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

echo "Deploying $REF to $NUTRITION_TRACKER_DEPLOY_HOST:$NUTRITION_TRACKER_DEPLOY_DIR"

remote "set -euo pipefail
cd '$NUTRITION_TRACKER_DEPLOY_DIR'
git fetch --all --prune
git checkout '$REF'
git pull --ff-only
.venv/bin/pip install -q -e . 2>&1 | tail -2 || true
NT_DB_PATH='$NUTRITION_TRACKER_DEPLOY_DB' .venv/bin/alembic upgrade head
sudo systemctl restart '$NUTRITION_TRACKER_DEPLOY_SERVICE'
sleep 3
systemctl is-active '$NUTRITION_TRACKER_DEPLOY_SERVICE'"

echo "Checking health"
remote "curl -fsS http://127.0.0.1:${NUTRITION_TRACKER_APP_PORT:-8000}/health" && echo
echo "Deployed."
