# Copy this file to .env and fill in values
# Required in production — unset means no auth (dev/local only)
NT_BEARER_TOKEN=replace-with-a-long-random-token
# Optional, non-admin credential accepted only from a loopback socket peer.
# Keep this distinct from NT_BEARER_TOKEN.
# NT_LOCAL_BEARER_TOKEN=replace-with-a-second-long-random-token

# Cloudflare tunnel token (from Zero Trust dashboard → Tunnels → your tunnel → token)
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# Optional overrides
# NT_DB_PATH=data/nutrition.db
