# Deployment target for this checkout. Copy to deploy/deploy.env and edit.
#
#   cp deploy/deploy.env.example deploy/deploy.env
#
# deploy/deploy.env is gitignored so host names, users and key paths stay out
# of the repository.

# Host running the tracker, and the SSH account used to reach it.
NT_DEPLOY_HOST=raspberrypi.local
NT_DEPLOY_USER=pi

# Optional: path to a specific SSH key. Leave empty to use the SSH agent or
# whatever ~/.ssh/config already resolves for this host.
NT_DEPLOY_SSH_KEY=

# Checkout, systemd unit and database path on the target host.
NT_DEPLOY_DIR=/home/pi/nutritiontracker
NT_DEPLOY_SERVICE=nutritiontracker
NT_DEPLOY_DB=/home/pi/nutritiontracker/data/nutrition.db

# Where backups are written on the target host before a database swap.
NT_DEPLOY_BACKUP_DIR=/home/pi/db-backups

# Public base URL, used by the smoke tests in docs/live-smoke-test.md.
NT_PUBLIC_URL=https://tracker.example.com
