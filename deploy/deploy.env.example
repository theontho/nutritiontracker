# Deployment target for this checkout.
#
#   cp deploy/deploy.env.example deploy/deploy.env
#
# deploy/deploy.env is gitignored, so host names, users and key paths stay out
# of the repository. Replace every placeholder below with your own values.
#
# Everything here is NUTRITION_TRACKER_*, read by the bin/ scripts and
# config/deploy.yml. The application's own settings use the NT_* prefix
# declared in app/config.py and live in the host's environment file instead.

# ---------------------------------------------------------------------------
# Connection. Required by every bin/ script.
# ---------------------------------------------------------------------------
NUTRITION_TRACKER_DEPLOY_HOST=nutrition.local
NUTRITION_TRACKER_DEPLOY_USER=pi

# Path to the SSH key. Leave empty to use the agent, or whatever ~/.ssh/config
# already resolves for this host.
NUTRITION_TRACKER_DEPLOY_SSH_KEY=

# ---------------------------------------------------------------------------
# Public endpoint. NUTRITION_TRACKER_PUBLIC_HOST is the proxy host in config/deploy.yml;
# NUTRITION_TRACKER_PUBLIC_URL is used by the smoke tests in docs/live-smoke-test.md.
# ---------------------------------------------------------------------------
NUTRITION_TRACKER_PUBLIC_HOST=nutrition.example.com
NUTRITION_TRACKER_PUBLIC_URL=https://nutrition.example.com

# ---------------------------------------------------------------------------
# Container hosts deployed with Kamal (config/deploy.yml).
# Ignore these on a host that runs the app under systemd.
# NUTRITION_TRACKER_REGISTRY_HOST defaults to NUTRITION_TRACKER_DEPLOY_HOST when unset.
# ---------------------------------------------------------------------------
#NUTRITION_TRACKER_REGISTRY_HOST=registry.local
NUTRITION_TRACKER_DEPLOY_ARCH=arm64

# ---------------------------------------------------------------------------
# Hosts that run the app under systemd from a git checkout, driven by
# bin/install-systemd, bin/deploy, bin/db-backup and bin/db-push.
# Ignore these on a Kamal host.
# ---------------------------------------------------------------------------
NUTRITION_TRACKER_DEPLOY_BRANCH=master
NUTRITION_TRACKER_DEPLOY_DIR=/home/pi/nutritiontracker
NUTRITION_TRACKER_DEPLOY_SERVICE=nutritiontracker
NUTRITION_TRACKER_DEPLOY_DB=/home/pi/nutritiontracker/data/nutrition.db
NUTRITION_TRACKER_DEPLOY_BACKUP_DIR=/home/pi/db-backups

# Optional, shown with their defaults. bin/install-systemd uses these to
# render deploy/systemd/nutritiontracker.service.template.
#
# Bind to 127.0.0.1 and put a tunnel or reverse proxy in front of it. Only
# widen this to 0.0.0.0 if you understand the exposure.
#NUTRITION_TRACKER_BIND_HOST=127.0.0.1
#NUTRITION_TRACKER_APP_PORT=8000
#NUTRITION_TRACKER_DEPLOY_GROUP=<defaults to NUTRITION_TRACKER_DEPLOY_USER>
#NUTRITION_TRACKER_DEPLOY_ENV_FILE=/etc/nutritiontracker/nutritiontracker.env
#NUTRITION_TRACKER_REPO_URL=https://github.com/gregmushen/nutritiontracker.git
#NT_MULTI_USER_ENABLED=true

# Resource guards written into the unit. Sized for a 2-4 GB single-board
# computer; raise them if you serve a much larger catalog.
#NUTRITION_TRACKER_MEMORY_HIGH=512M
#NUTRITION_TRACKER_MEMORY_MAX=768M
#NUTRITION_TRACKER_TASKS_MAX=64
#NUTRITION_TRACKER_CPU_WEIGHT=100

# ---------------------------------------------------------------------------
# Where the bulk USDA and OpenFoodFacts downloads live on the host, used by
# bin/import-usda and bin/import-off.
# ---------------------------------------------------------------------------
NUTRITION_TRACKER_DATA_DIR=/home/pi/nutrition-data
